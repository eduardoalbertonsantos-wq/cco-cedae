PORT=3000
NODE_ENV=production

# Segredo para geração e validação de tokens JWT
JWT_SECRET=cco-secret-key-change-in-production-2026
JWT_EXPIRES_IN=8h

# Caminho do banco SQLite (local ou arquivo persistente)
DB_PATH=./backend/database/cco.sqlite

# Configuração de envio de e-mails de alerta e expediente (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=seu-email@gmail.com
SMTP_PASS=sua-senha-de-aplicativo
SMTP_FROM="CCO CEDAE" <seu-email@gmail.com>
EMAIL_DESTINATARIOS=coordenacao.cco@cedae.com.br,supervisao@cedae.com.br
