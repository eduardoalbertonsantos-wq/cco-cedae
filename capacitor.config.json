{
  "appId": "br.gov.rj.cedae.cco.supervisao",
  "appName": "CCO — SUPERVISÃO OPERACIONAL",
  "webDir": "frontend",
  "bundledWebRuntime": false,
  "server": {
    "androidScheme": "https",
    "cleartext": true,
