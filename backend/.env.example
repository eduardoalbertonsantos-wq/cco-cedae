# CCO - Centro de Controle Operacional
# Configurações do Sistema

# Servidor
PORT=3000
NODE_ENV=development

# JWT
JWT_SECRET=cco-secret-key-change-in-production-2026
JWT_EXPIRES_IN=8h

# E-mail SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=seu-email@gmail.com
SMTP_PASS=sua-senha-de-app
SMTP_FROM=CCO Sistema <cco@empresa.com>

# E-mail destino dos relatórios
EMAIL_DESTINO=eduardoalbertonsantos@gmail.com

# Google Webhook Secret
GOOGLE_WEBHOOK_SECRET=cco-webhook-secret-change-me
